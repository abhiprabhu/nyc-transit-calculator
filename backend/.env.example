PORT=3001

# Postgres connection string.
DATABASE_URL=postgres://user@localhost:5432/nyc_transit

# Set to "true" to force SSL on the Postgres connection (needed for most
# hosted Postgres providers, e.g. Render, over an external connection).
# PGSSL=true

# Comma-separated list of allowed frontend origins in production, e.g.
# https://nyc-transit-calculator.vercel.app. Unset = allow all origins.
# CORS_ORIGIN=https://nyc-transit-calculator.vercel.app

# Optional: override the default MTA subway GTFS static feed URL.
# GTFS_SUBWAY_URL=https://rrgtfsfeeds.s3.amazonaws.com/gtfs_subway.zip

# Optional: identifying User-Agent sent with geocoding requests to OSM
# Nominatim (services/geocoding.js). Nominatim's usage policy asks for a
# real identifying string, ideally with contact info, so it can reach you
# if usage needs attention: https://operations.osmfoundation.org/policies/nominatim/
# NOMINATIM_USER_AGENT=nyc-transit-calculator/1.0 (you@example.com)

